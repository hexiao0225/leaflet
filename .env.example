# Written by `stripe projects env --pull`. Never commit the real .env.
#
#   stripe projects add auth0/client
#   stripe projects add neon/postgres
#   stripe projects add vercel/project

# --- Auth0 (from auth0/client) ---
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# --- Auth0 v4 extras the CLI does not write. See the README. ---
# openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# --- Neon (from neon/postgres) ---
# DATABASE_URL is accepted as an alias.
NEON_POSTGRES_CONNECTION_STRING=

# --- Vercel (from vercel/project) ---
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# --- Optional: open the editor without Auth0 ---
# LEAFLET_DEMO_USER="Your Name"
